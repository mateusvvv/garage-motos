rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      return isSignedIn()
        && request.auth.token.email in [
          "leonardo1412goncalves@gmail.com",
          "garagemotos@gmail.com"
        ];
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "leonardo1412goncalves@gmail.com";
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isTeamMember();
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isTeamMember();
      // Visitantes podem criar solicitações ('request'), mas apenas a equipe pode criar outros tipos (como 'block')
      allow create: if (request.resource.data.type == 'request') || isTeamMember();
      allow update, delete: if isTeamMember();
    }

    match /serviceOrders/{orderId} {
      allow read, create, update: if isTeamMember();
      allow delete: if isAdmin();
    }

    match /openOrders/{orderId} {
      allow read, create, update, delete: if isTeamMember();
    }

    match /financeExpenses/{expenseId} {
      allow read, create, update, delete: if isTeamMember();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Bloqueio padrão para qualquer outra coleção ou caminho não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
